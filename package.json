{
  "name": "dsh-privacy-guard",
  "description": "DeepSeek Harness 隐私保护插件：监控本地 Privacy Gateway (:8317) 与 Qwen2.5-0.5B 小模型，管理凭据脱敏、豁免白名单与加密密钥，并提供带凭据保护的模型入口与部署按钮",
  "descriptionEn": "Privacy Protection plugin for DeepSeek Harness: monitors the local Privacy Gateway (:8317) and Qwen2.5-0.5B model, manages credential redaction, the exemption whitelist and the encryption key, and adds a credential-protected model entry plus deployment controls.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "license": "Apache-2.0",
  "author": "amwangfan",
  "repository": {
    "type": "git",
    "url": "https://github.com/amwangfan/dsh-privacy-guard.git"
  },
  "homepage": "https://github.com/amwangfan/dsh-privacy-guard",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dlp",
    "dsh-plugin",
    "gateway",
    "privacy",
    "protection",
    "qwen",
    "redaction",
    "security"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.12"
  },
  "scripts": {
    "build": "node build.js",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
